# Server-side only. Copy to .env for local development (never commit .env).

# Anthropic API key for the judge. For local work without spending credit,
# point ANTHROPIC_BASE_URL at scripts/mock-anthropic.mjs instead.
ANTHROPIC_API_KEY=

# Server-side transcription (Cloudflare Workers AI Whisper). With these set,
# ANY browser works (Safari, Firefox, iPhone, Android) and Arabic quality
# jumps. Create an API token with Workers AI permission at dash.cloudflare.com.
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=

# TURN relay — needed for cross-network video (strict NATs, campus wifi).
# PREFERRED: Cloudflare Realtime TURN (1TB/mo free). Create a TURN key at
# dash.cloudflare.com -> Realtime -> TURN, then set both values below; the
# server mints short-lived credentials automatically (see server/src/turn.ts).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# LEGACY alternative: static-credential TURN (e.g. metered.ca). Ignored unless
# all three are set. Comma-separated URLs; include a :443?transport=tcp variant.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Set to "fast" for 30-second test debates (5s/4s/3s turns, 3s reveal)
DEBATE_SPEED=

# PORT is injected by Railway in production; defaults to 3000 locally

# Google sign-in (OAuth 2.0 / OpenID Connect). Unset means the whole sign-in
# path is hidden and everyone plays as a guest: no ranked, no saved history.
# Create credentials at console.cloud.google.com, redirect /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies. Falls back to a value derived from
# GOOGLE_CLIENT_SECRET; set it to rotate sessions independently.
SESSION_SECRET=

# PostgreSQL. Unset means matches still run and are judged, nothing is stored.
DATABASE_URL=

# Bot voices and the spoken verdict (ElevenLabs). Unset means text only.
ELEVENLABS_API_KEY=

# Opens the keyed /stats and /admin routes, read from the x-stats-key header.
# Unset means those routes do not exist at all.
STATS_KEY=

# Ceiling on model calls per hour across the whole server (default 600).
LLM_HOURLY_CAP=

# Off by default. Settle-it mode, where two people submit a real argument
# and the judge rules on it instead of a motion.
DISPUTE_MODE=

# Set to 0 to unlock every bot regardless of campaign progress (local only).
CAMPAIGN_LOCKS=
