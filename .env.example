# Server-side only. Copy to .env for local development (never commit .env).

# Anthropic API key for the judge (needed from slice 5 onward)
ANTHROPIC_API_KEY=

# TURN relay — needed for cross-network video (strict NATs, campus wifi).
# PREFERRED: Cloudflare Realtime TURN (1TB/mo free). Create a TURN key at
# dash.cloudflare.com -> Realtime -> TURN, then set both values below; the
# server mints short-lived credentials automatically (see server/src/turn.ts).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# LEGACY alternative: static-credential TURN (e.g. metered.ca). Ignored unless
# all three are set. Comma-separated URLs; include a :443?transport=tcp variant.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Set to "fast" for 30-second test debates (5s/4s/3s turns, 3s reveal)
DEBATE_SPEED=

# PORT is injected by Railway in production; defaults to 3000 locally
