# Server-side only. Copy to .env for local development (never commit .env).

# Anthropic API key for the judge (needed from slice 5 onward)
ANTHROPIC_API_KEY=

# TURN relay (metered.ca Open Relay or similar) — needed for cross-network video.
# Comma-separated URLs; include a :443?transport=tcp variant for strict networks.
TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turn:standard.relay.metered.ca:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=

# Set to "fast" for 30-second test debates (5s/4s/3s turns, 3s reveal)
DEBATE_SPEED=

# PORT is injected by Railway in production; defaults to 3000 locally
